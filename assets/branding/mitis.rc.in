// Recursos de Mitis.exe en Windows (lo configura CMakeLists.txt).
// Icono: Explorador, barra de tareas, accesos directos. Datos de la versión:
// Windows enseña FileDescription como nombre de la aplicación (notificaciones,
// Administrador de tareas, mezclador de volumen, «Abrir con»); sin ellos
// enseña «Mitis.exe»
#include <winver.h>

IDI_ICON1 ICON "@MITIS_BRANDING_DIR@/mitis.ico"

VS_VERSION_INFO VERSIONINFO
FILEVERSION     @PROJECT_VERSION_MAJOR@,@PROJECT_VERSION_MINOR@,@PROJECT_VERSION_PATCH@,0
PRODUCTVERSION  @PROJECT_VERSION_MAJOR@,@PROJECT_VERSION_MINOR@,@PROJECT_VERSION_PATCH@,0
FILEFLAGSMASK   VS_FFI_FILEFLAGSMASK
FILEFLAGS       0
FILEOS          VOS_NT_WINDOWS32
FILETYPE        VFT_APP
FILESUBTYPE     VFT2_UNKNOWN
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        // Español (0x0C0A), Unicode (1200)
        BLOCK "0C0A04B0"
        BEGIN
            VALUE "CompanyName",      "StartCode"
            VALUE "FileDescription",  "Mitis"
            VALUE "FileVersion",      "@PROJECT_VERSION@@MITIS_VERSION_SUFFIX@"
            VALUE "InternalName",     "Mitis"
            VALUE "OriginalFilename", "Mitis.exe"
            VALUE "ProductName",      "Mitis"
            VALUE "ProductVersion",   "@PROJECT_VERSION@@MITIS_VERSION_SUFFIX@"
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x0C0A, 1200
    END
END
